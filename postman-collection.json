{
  "info": {
    "name": "Warehouse Idea Minimal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Items",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/items",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "items"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3300"
    }
  ]
}
